      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Membrane-Tethered Mucin 1 Is Stimulated by Interferon and Virus Infection in Multiple Cell Types and Inhibits Influenza A Virus Infection in Human Airway Epithelium</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:identifier>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">10.1128/mbio.01055-22</rdf:li>
        </rdf:Alt>
      </dc:identifier>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Ethan Iverson</rdf:li>
          <rdf:li>Kira Griswold</rdf:li>
          <rdf:li>Daniel Song</rdf:li>
          <rdf:li>Talita B. Gagliardi</rdf:li>
          <rdf:li>Kajal Hamidzadeh</rdf:li>
          <rdf:li>Mehmet Kesimer</rdf:li>
          <rdf:li>Sanju Sinha</rdf:li>
          <rdf:li>Melissa Perry</rdf:li>
          <rdf:li>Gregg A. Duncan</rdf:li>
          <rdf:li>Margaret A. Scull</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Research Article</rdf:li>
          <rdf:li xml:lang="x-repair">Research Article</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>influenza virus</rdf:li>
