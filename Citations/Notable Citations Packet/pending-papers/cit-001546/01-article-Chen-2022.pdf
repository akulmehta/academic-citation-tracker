      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Structural Insight into Terminal Galactose Recognition by Two Non-HBGA Binding GI.3 Noroviruses</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:identifier>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">10.1128/jvi.00420-22</rdf:li>
        </rdf:Alt>
      </dc:identifier>
      <dc:creator>
        <rdf:Seq>
