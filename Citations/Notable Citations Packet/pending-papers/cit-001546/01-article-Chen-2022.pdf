          <rdf:li>Huiling Kang</rdf:li>
          <rdf:li>Ming Tan</rdf:li>
          <rdf:li>Jingyuan Cong</rdf:li>
          <rdf:li>Dan Su</rdf:li>
          <rdf:li>Xuemei Li</rdf:li>
          <rdf:li>Yutao Chen</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Structure and Assembly</rdf:li>
          <rdf:li xml:lang="x-repair">Structure and Assembly</rdf:li>
        </rdf:Alt>
      </dc:description>
