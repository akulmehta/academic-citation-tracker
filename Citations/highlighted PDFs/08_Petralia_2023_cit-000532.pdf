         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Unraveling cross-reactivity of anti-glycan IgG responses in filarial nematode infections</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
